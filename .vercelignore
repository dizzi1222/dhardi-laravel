# Vercel builds the image from what it uploads, so anything listed here is also
# kept out of the Docker build context. The package manifest on a development
# machine lists require-dev providers (Laravel Boost) whose classes are absent
# from a --no-dev install, and package:discover fails when it reads that foreign
# manifest back.
bootstrap/cache/*.php
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
