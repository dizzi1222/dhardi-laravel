# FrankenPHP-specific routing.
#
# Two things are deliberate here:
#
#  1. `route` with an explicit `try_files` + `rewrite` to index.php, instead of
#     the `php_server` shorthand. The shorthand lets Caddy's file server and
#     PHP both try to produce headers, which produces
#     "Cannot modify header information - headers already sent" from
#     Response::sendHeaders() when the two overlap on a static file. Naming the
#     handler explicitly keeps exactly one owner per request.
#
#  2. The scheme is pinned to http. A bare `:80` is read as a domain named "80"
#     and Caddy spends three days failing to get a certificate for it.
http://:80 {
	root * /app/public

	encode zstd gzip

	# Content-hashed assets, cached indefinitely.
	@assets path /build/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Existing static files are served as files, with no PHP involved.
	@static {
		file
		not path /index.php
	}
	handle @static {
		file_server
	}

	# Everything else is the Laravel front controller.
	handle {
		rewrite * /index.php
		php_server
	}
}