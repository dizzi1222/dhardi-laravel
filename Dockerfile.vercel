# syntax=docker/dockerfile:1

# Frontend assets. Done in its own stage so a copy-only change to application
# code does not invalidate the npm layer — which on a cold build is the
# difference between seconds and a couple of minutes.
FROM node:24-bookworm-slim AS assets

WORKDIR /app

# Copied before the manifest so the install layer is cached independently of the
# lockfile's consumers.
COPY package.json package-lock.json ./

# `--ignore-scripts` because the only lifecycle script we would run is optional,
# and running arbitrary postinstall hooks during an image build is not something
# to opt into by default.
RUN npm ci --ignore-scripts

COPY resources/js ./resources/js
COPY resources/css ./resources/css
COPY vite.config.ts tsconfig.json ./

RUN npm run build


# Composer dependencies. Also a separate stage, and also `--no-dev`, so the
# runtime image carries no test or dev tooling.
FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./

# No scripts here: `package:discover` runs in the runtime stage, where the full
# application source and the database file are present. Running it now would
# write a package manifest from a tree that has no application around it.
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --prefer-dist \
    --optimize-autoloader


FROM dunglas/frankenphp:1-php8.4-bookworm AS runtime

# intl for the locale-aware helpers, pdo_mysql for production, opcache because a
# request-per-instance model pays the compile cost on every cold start.
RUN install-php-extensions intl pdo_mysql opcache \
 && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# FrankenPHP serves the response over its own writer, so PHP must never flush
# output on its own. With display_errors on, any notice emitted during bootstrap
# becomes response body, the headers are considered already sent, and
# Symfony's sendHeaders() throws "Cannot modify header information" — a 500 on
# every HTML page while the API routes keep working.
RUN { \
      echo 'display_errors = Off'; \
      echo 'display_startup_errors = Off'; \
      echo 'log_errors = On'; \
      echo 'error_log = /dev/stderr'; \
      echo 'output_buffering = 4096'; \
      echo 'zlib.output_compression = Off'; \
      echo 'implicit_flush = Off'; \
      echo 'memory_limit = 256M'; \
    } > "$PHP_INI_DIR/conf.d/app.ini"

WORKDIR /app

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    CACHE_STORE=file \
    SESSION_DRIVER=file \
    QUEUE_CONNECTION=sync \
    DB_CONNECTION=sqlite \
    DB_DATABASE=/app/database/database.sqlite \
    COMPOSER_ALLOW_SUPERUSER=1

COPY --from=vendor /app/vendor ./vendor
COPY . .

COPY --from=assets /app/public/build ./public/build

# The application source is present now, so the package manifest can be built
# and the routes cached.
#
# `bootstrap/cache/*.php` is excluded by `.dockerignore`, which is load-bearing
# rather than tidy. A developer's machine has a `packages.php` that lists dev
# providers — Laravel Boost among them — and that manifest would be read back
# here and fail on a class the `--no-dev` install does not contain. Building it
# fresh from this image's own vendor directory is the fix.
RUN php artisan package:discover --ansi \
 && php artisan route:cache --ansi \
 && chown -R www-data:www-data /app/storage /app/bootstrap/cache

# The content is baked into the image.
#
# A container function has a writable filesystem for the life of the instance,
# but nothing survives a scale-in. Seeding at build time means the portfolio —
# the part a visitor actually reads — is present on every cold start instead of
# depending on a database that may not be configured yet.
#
# The file is left writable by `www-data`, because the assistant still appends to
# it for as long as the instance lives. A read-only file turns every one of those
# writes into an error, and the point of the best-effort writes is that they
# degrade to a log line rather than taking the request down.
RUN touch /app/database/database.sqlite \
 && php artisan migrate --force --ansi \
 && php artisan db:seed --force --ansi \
 && chown www-data:www-data /app/database/database.sqlite \
 && chmod 664 /app/database/database.sqlite

COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

# Binding to a privileged port inside the container and letting the platform map
# it is the arrangement that works with a runtime that expects PORT.
RUN setcap 'CAP_NET_BIND_SERVICE=+eip' /usr/local/bin/frankenphp \
 && chown -R www-data:www-data /config/caddy /data/caddy

USER www-data

EXPOSE 80

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]