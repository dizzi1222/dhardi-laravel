# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Diego Härdi"

# What a visitor, a crawler or a link preview sees as the author.
#
# The page title, the meta description, the footer and the assistant's system
# prompt all read this value, so the public identity is defined in one place
# instead of being repeated across every language file. The full legal name stays
# in config/portfolio.php and is not rendered anywhere.
#
# Set PUBLIC_DISPLAY_NAME="D. Härdi" to publish under a shorter form.
PUBLIC_DISPLAY_NAME="Diego Härdi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# `de` is deliberate: German is the primary language of the site. The locale
# itself is resolved per request by App\Http\Middleware\SetLocale.
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# `stderr` on Vercel so logs land in the runtime log instead of a filesystem
# that does not survive between instances.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite locally so the project runs with no external service. Production uses
# MySQL; see "Databases" in the README for the connection settings.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dhardi_laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session, cache, queue
# ---------------------------------------------------------------------------
# The database store is used for both session and cache because it is the only
# store that is shared between instances. A file or array store would give every
# instance a private cache and the prompt cache would silently never hit.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
# Which customer this instance belongs to. One deployment per customer, so this
# is baked into the instance rather than looked up per request. `php artisan
# tenant:provision` prints the block you need to set for a new customer.
TENANT_SLUG=dhardi

# Set to true to pick a language from Accept-Language when the visitor has no
# stored preference. Off by default so the German default holds.
TENANCY_DETECT_BROWSER=false

# ---------------------------------------------------------------------------
# AI backends
# ---------------------------------------------------------------------------
# All optional. With none of them set, the chain falls through to the
# deterministic responder and the assistant still answers — see "The AI layer".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

LLM_MAX_ATTEMPTS=3
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN=30
LLM_CACHE_TTL=900
LLM_CACHE_ENABLED=true
LLM_CACHE_STORE=database

# ---------------------------------------------------------------------------
# Site content
# ---------------------------------------------------------------------------
# Number of tests in the suite, shown next to the Laravel requirement on the
# site. Update when the suite grows.
PORTFOLIO_TEST_COUNT=78